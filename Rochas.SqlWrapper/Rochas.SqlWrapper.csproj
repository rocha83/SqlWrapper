<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rochas.SqlWrapper</RootNamespace>
    <AssemblyName>Rochas.SqlWrapper</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Copyright>Renato Rocha</Copyright>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/SqlWrapper</RepositoryUrl>
    <Description>Rochas SqlWrapper - SQL statement translation layer (multi-dialect) shared by BWOQ and DapperRepository</Description>
    <PackageTags>sql ansisql mysql sqlserver postgresql sqlite parser translate rochas dapper bwoq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>sqlwrapper-icon.png</PackageIcon>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <Version>1.4.9</Version>
    <PackageReleaseNotes>v1.4.9 - [FIX] DateOnly/TimeOnly interpolated as quoted ISO literals (yyyy-MM-dd, HH:mm:ss; MinValue becomes NULL) — without it PostgreSQL read DateOnly as integer arithmetic (42804), an error masked on SQLite by type affinity. v1.4.8 - [FIX] GROUP BY with aggregates: SELECT with keys only (exact, case-insensitive match) + aggregate expressions, with AS alias when the column differs from the property (42803 on PostgreSQL; Dapper did not materialize the key). v1.4.6 - [FIX] ParseEntityPaged accepts groupAttributes (GROUP BY + aggregates in paged queries; rescue of the data-toolkit-init branch). v1.4.5 - [FIX] GroupBy with aggregates: SELECT with keys + expressions only. [PERF] EntityReflector with cache. [DOCS] README in 5 languages. Data.Specification reference via NuGet (1.6.3). v1.4.4 - Build/pack normalization. v1.0.0 - Parser/reflector extraction from DapperRepository 1.9.5.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rochas.Data.Specification" Version="1.6.3" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="sqlwrapper-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>