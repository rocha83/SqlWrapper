<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rochas.SqlWrapper</RootNamespace>
    <AssemblyName>Rochas.SqlWrapper</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Copyright>Renato Rocha</Copyright>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/rocha83/SqlWrapper</RepositoryUrl>
    <Description>Rochas SqlWrapper - SQL statement translation layer (multi-dialect) shared by BWOQ and DapperRepository</Description>
    <PackageTags>sql ansisql mysql sqlserver postgresql sqlite parser translate rochas dapper bwoq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <Version>1.4.6</Version>
    <PackageReleaseNotes>v1.4.6 - [FIX] ParseEntityPaged aceita groupAttributes (GROUP BY + agregados em paginadas; resgate da branch data-toolkit-init). v1.4.5 - [FIX] GroupBy com agregados: SELECT só com chaves + expressões (42803 no PostgreSQL). [PERF] EntityReflector com cache. [DOCS] README em 5 idiomas. Referência Data.Specification via NuGet (1.6.3). v1.4.4 - Build/pack normalization. v1.0.0 - Extração do parser/refletor do DapperRepository 1.9.5.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rochas.Data.Specification" Version="1.6.3" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>