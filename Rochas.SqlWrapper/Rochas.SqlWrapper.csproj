<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rochas.SqlWrapper</RootNamespace>
    <AssemblyName>Rochas.SqlWrapper</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Renato Rocha</Authors>
    <Copyright>Renato Rocha</Copyright>
    <Description>Rochas SqlWrapper - SQL statement translation layer (multi-dialect) shared by BWOQ and DapperRepository</Description>
    <PackageTags>sql ansisql mysql sqlserver postgresql sqlite parser translate rochas dapper bwoq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>GNUv2_License.txt</PackageLicenseFile>
    <Version>1.4.4</Version>
    <PackageReleaseNotes>v1.4.4 - Build/pack normalization (versioned nupkg at repo root). v1.0.0 - Extract shared EntitySqlParser/EntityReflector from Rochas.DapperRepository 1.9.5 into a standalone translation layer used by BWOQ ToSql() and by the DapperRepository ORM. Namespaces now Rochas.SqlWrapper.Helpers and Rochas.SqlWrapper.Helpers.SQL.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rochas.DapperRepository.Specification" Version="1.5.2" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GNUv2_License.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>